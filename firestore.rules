rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Accounts: game saves, one document per account, private to its owner.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Flappy Bird: everyone may read the board, only the owner writes their row.
    match /flappy/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'score', 'at'])
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100000
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 24;
    }

    match /flappy_week/{week}/scores/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'score', 'at'])
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100000
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 24;
    }

    // People list: signed-in players see names, you only write your own entry.
    match /people/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;
    }

    // One chat document per pair of players.
    match /chats/{chatId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.ids;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.ids
        && request.resource.data.ids.size() == 2;
      allow update: if request.auth != null && request.auth.uid in resource.data.ids;
      allow delete: if false;
    }

    match /chats/{chatId}/messages/{msgId} {
      allow read: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.ids;
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.ids;
      allow update, delete: if false;
    }

    // Online fighting rooms: only used to connect two players (the game itself
    // runs directly between the two browsers, so almost nothing is stored here).
    match /rooms/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.host == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.host == request.auth.uid
            || (!('guest' in resource.data) && request.resource.data.guest == request.auth.uid));
      allow delete: if request.auth != null && resource.data.host == request.auth.uid;
    }

    // Everything else stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
