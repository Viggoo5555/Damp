rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Accounts: game saves, one document per account, private to its owner.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Flappy Bird: everyone may read the board, only the owner writes their row.
    match /flappy/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'score', 'at'])
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100000
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 24;
    }

    match /flappy_week/{week}/scores/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'score', 'at'])
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100000
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 24;
    }

    // People list: signed-in players see names, you only write your own entry.
    match /people/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;
    }

    // One chat document per pair of players.
    match /chats/{chatId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.ids;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.ids
        && request.resource.data.ids.size() == 2;
      allow update: if request.auth != null && request.auth.uid in resource.data.ids;
      allow delete: if false;
    }

    match /chats/{chatId}/messages/{msgId} {
      allow read: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.ids;
      // A message is text, a picture, or both. Pictures are the small JPEG
      // data URLs the site makes, never the original photo.
      allow create: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.ids
        && request.resource.data.from == request.auth.uid
        && request.resource.data.at is int
        && request.resource.data.keys().hasOnly(['from', 'at', 'text', 'image'])
        && (!('text' in request.resource.data)
            || (request.resource.data.text is string
                && request.resource.data.text.size() <= 500))
        && (!('image' in request.resource.data)
            || (request.resource.data.image is string
                && request.resource.data.image.size() <= 700000
                && request.resource.data.image.matches('data:image/(jpeg|png|webp);base64,.*')))
        && (('image' in request.resource.data)
            || (('text' in request.resource.data) && request.resource.data.text.size() > 0));
      // Only the sender may take a message back
      allow delete: if request.auth != null && resource.data.from == request.auth.uid;
      allow update: if false;
    }

    // Online fighting rooms: only used to connect two players (the game itself
    // runs directly between the two browsers, so almost nothing is stored here).
    match /rooms/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.host == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.host == request.auth.uid
            || (!('guest' in resource.data) && request.resource.data.guest == request.auth.uid));
      allow delete: if request.auth != null && resource.data.host == request.auth.uid;
    }

    // ---------- Secret Room ----------
    // The player's own save: coins, room, collection. Private to its owner.
    match /secret_rooms/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // The public room snapshot every visitor reads. Anyone signed in may look;
    // only the owner writes, and only the fields the game actually uses.
    match /secret_public/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'level', 'room', 'updated'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 24
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 99
        && request.resource.data.room is map
        && request.resource.data.room.items is list
        && request.resource.data.room.items.size() <= 60;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // One heart per visitor per room, keyed "roomUid_visitorUid". Counts are
    // always a count of documents, so a player can never award themselves
    // hearts: you may write only the row that has you as the visitor, and
    // never towards your own room.
    match /secret_likes/{likeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && likeId == request.resource.data.to + '_' + request.auth.uid;
      allow delete: if request.auth != null && resource.data.from == request.auth.uid;
      allow update: if false;
    }

    // Competition entries: one room per player per week, snapshotted when they
    // enter. The id is "week_uid", so the week in the id must be the week in
    // the data and the uid must be yours.
    match /secret_entries/{entryId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'level', 'week', 'room', 'at'])
        && request.resource.data.week is string
        && entryId == request.resource.data.week + '_' + request.auth.uid
        && request.resource.data.room is map
        && request.resource.data.room.items is list
        && request.resource.data.room.items.size() <= 60;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // One vote per account per week, and never for your own room. Votes are
    // written once and cannot be changed afterwards.
    match /secret_votes/{voteId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && !exists(/databases/$(database)/documents/secret_votes/$(voteId))
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && request.resource.data.week is string
        && voteId == request.resource.data.week + '_' + request.auth.uid;
      allow update, delete: if false;
    }

    // ---------------- Outfit Battle ----------------

    // Private save: wardrobe, coins, history. Only the owner can read it.
    match /ob_profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // The public card the leaderboard and friend search read.
    match /ob_public/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'nameLower', 'level', 'wins', 'matches', 'votes', 'winsWeek', 'weekKey', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 20
        && request.resource.data.level is number
        && request.resource.data.wins is number && request.resource.data.wins >= 0
        && request.resource.data.matches is number && request.resource.data.matches >= 0;
    }

    // A heartbeat, never an assumption: friends only look online if this is fresh.
    match /ob_presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'online', 'at'])
        && request.resource.data.online is bool;
    }

    // Matchmaking. The room leader may attach a six-character room code to a
    // waiting player's ticket; nothing else on someone else's ticket is writable.
    match /ob_queue/{uid} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (
        request.auth.uid == uid || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roomCode'])
          && request.resource.data.roomCode is string
          && request.resource.data.roomCode.size() == 6
          && exists(/databases/$(database)/documents/ob_rooms/$(request.resource.data.roomCode))
          && get(/databases/$(database)/documents/ob_rooms/$(request.resource.data.roomCode)).data.host == request.auth.uid
        )
      );
    }

    // Rooms hold the roster, the theme and the phase clock. Players may change
    // only their own seat; phase fields move forward on the stored deadline.
    match /ob_rooms/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.host == request.auth.uid
        && request.auth.uid in request.resource.data.players.keys()
        && request.resource.data.players.size() >= 1
        && request.resource.data.players.size() <= 8
        && request.resource.data.phase == 'waiting'
        && request.resource.data.theme is string;
      allow update: if request.auth != null
        && (
          (
            request.resource.data.players.size() <= 8
            && (
              request.auth.uid in resource.data.players.keys() 
              || (!(request.auth.uid in resource.data.players.keys()) && request.auth.uid in request.resource.data.players.keys())
            )
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'updatedAt'])
            && request.resource.data.players.diff(resource.data.players).affectedKeys().hasOnly([request.auth.uid])
          ) 
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase', 'phaseEndsAt', 'presenter', 'order', 'closed', 'updatedAt', 'theme', 'themeName'])
            && (request.auth.uid == resource.data.host || (resource.data.phaseEndsAt is number && resource.data.phaseEndsAt <= request.time.toMillis()))
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['phase'])
              || request.resource.data.phase == 'results'
              || (resource.data.phase == 'waiting' && request.resource.data.phase == 'design')
              || (resource.data.phase == 'design' && request.resource.data.phase == 'runway')
              || (resource.data.phase == 'runway' && request.resource.data.phase == 'vote')
              || (resource.data.phase == 'vote' && request.resource.data.phase == 'results')
            )
          )
        );
      allow delete: if false;

      // One vote document per voter, created once. Editing or deleting is
      // impossible, and a voter may never pick themselves.
      match /votes/{voter} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == voter
          && request.resource.data.voter == request.auth.uid
          && request.resource.data.picks is list
          && request.resource.data.picks.size() >= 1
          && request.resource.data.picks.size() <= 3
          && !(request.auth.uid in request.resource.data.picks);
        allow update, delete: if false;
      }
    }

    // A reward is claimed once per room per account; the id encodes both.
    match /ob_claims/{claimId} {
      // Settling a match starts by looking for an existing claim, so a missing
      // document is a normal read; other people's claims stay private.
      allow read: if request.auth != null
        && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.room is string
        && claimId == request.resource.data.room + '_' + request.auth.uid
        && request.resource.data.coins is number
        && request.resource.data.coins >= 0
        && request.resource.data.coins <= 400
        && request.resource.data.xp is number
        && request.resource.data.xp >= 0
        && request.resource.data.xp <= 140
        && request.resource.data.win is bool;
      allow update, delete: if false;
    }

    // ---------------- Last Stand ----------------

    // Private save: level, XP, coins, rating, cosmetics, quests, records.
    match /ls_players/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 16
        && request.resource.data.level is int && request.resource.data.level >= 1 && request.resource.data.level <= 999
        && request.resource.data.xp is int && request.resource.data.xp >= 0 && request.resource.data.xp <= 10000000
        && request.resource.data.coins is int && request.resource.data.coins >= 0 && request.resource.data.coins <= 10000000
        && request.resource.data.rating is int && request.resource.data.rating >= 0 && request.resource.data.rating <= 5000;
    }

    // The public leaderboard card. Read by everyone signed in, written by its owner.
    match /ls_board/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'level', 'rating', 'wins', 'matches', 'at'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 16
        && request.resource.data.level is int && request.resource.data.level >= 1
        && request.resource.data.rating is int && request.resource.data.rating >= 0 && request.resource.data.rating <= 5000
        && request.resource.data.wins is int && request.resource.data.wins >= 0
        && request.resource.data.matches is int && request.resource.data.matches >= 0;
    }

    // A heartbeat. Online only counts while the timestamp is fresh.
    match /ls_presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'at', 'inRoom', 'level', 'rating'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 16
        && request.resource.data.at is number;
    }

    // A room holds the roster, the phase clock and the elimination records.
    // The host drives the match. Anyone else may only claim host once the
    // stored host heartbeat has gone stale, so a dropped host cannot freeze
    // the room for everyone else.
    match /ls_rooms/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.code == code
        && request.resource.data.host == request.auth.uid
        && request.resource.data.phase == 'lobby'
        && request.resource.data.round == 0
        && request.resource.data.seq == 0
        && request.resource.data.maxPlayers is int
        && request.resource.data.maxPlayers >= 2
        && request.resource.data.maxPlayers <= 20;
      allow update: if request.auth != null
        && request.resource.data.code == resource.data.code
        && request.resource.data.round is int && request.resource.data.round >= 0 && request.resource.data.round <= 40
        && request.resource.data.seq is int && request.resource.data.seq >= 0 && request.resource.data.seq <= 40
        && (
          (request.auth.uid == resource.data.host
            && request.resource.data.host == resource.data.host)
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['host', 'hostSeen'])
            && request.resource.data.host == request.auth.uid
            && resource.data.hostSeen + 12000 < request.time.toMillis()
          )
        );
      allow delete: if request.auth != null && request.auth.uid == resource.data.host;

      // One seat per player, written only by its owner. Stale seats are
      // ignored by the client, so a closed tab never keeps a lobby full.
      match /presence/{uid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 16
          && request.resource.data.at is number;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      // One score per player per round, written only by its owner. A round
      // number already used cannot be rewritten with new numbers, which stops
      // a player resubmitting a better score after the round closed.
      match /scores/{uid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.seq is int
          && request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.score <= 100000
          && request.resource.data.perf is number
          && request.resource.data.perf >= 0
          && request.resource.data.perf <= 1;
        allow update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.seq is int
          && request.resource.data.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score', 'perf', 'at', 'name'])
          && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 100000
          && request.resource.data.perf is number && request.resource.data.perf >= 0 && request.resource.data.perf <= 1;
        allow delete: if request.auth != null
          && (request.auth.uid == uid
            || get(/databases/$(database)/documents/ls_rooms/$(code)).data.host == request.auth.uid);
      }
    }

    // ---------------- Pet Café ----------------

    // The player's own café save. Private to its owner; the game writes the
    // whole packed state, so there are no per-field constraints here.
    match /petcafe_saves/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // The public café card visitors read: name, level, layout and active
    // animals. Any signed-in player may browse it; only its owner writes it,
    // and only the fields the game actually uses.
    match /petcafe_public/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'nameLower', 'level', 'xp', 'likes', 'rating', 'rep', 'layout', 'animals', 'updated'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.nameLower is string
        && request.resource.data.nameLower.size() <= 20
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 99
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && request.resource.data.likes is int
        && request.resource.data.likes >= 0
        && request.resource.data.rating is number
        && request.resource.data.rating >= 0
        && request.resource.data.rating <= 5
        && request.resource.data.rep is int
        && request.resource.data.rep >= 0
        && request.resource.data.rep <= 100
        && request.resource.data.layout is map
        && request.resource.data.layout.keys().hasOnly(['floor', 'wall', 'expansions', 'items'])
        && request.resource.data.layout.floor is string
        && request.resource.data.layout.wall is string
        && request.resource.data.layout.expansions is int
        && request.resource.data.layout.expansions >= 0
        && request.resource.data.layout.expansions <= 2
        && request.resource.data.layout.items is list
        && request.resource.data.layout.items.size() <= 140
        && request.resource.data.animals is list
        && request.resource.data.animals.size() <= 6
        && request.resource.data.updated is number;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // One heart per visitor per café, keyed "cafeUid_visitorUid". You may only
    // write the row with yourself as the visitor, never towards your own café.
    match /petcafe_likes/{likeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && request.resource.data.at is number
        && request.resource.data.keys().hasOnly(['from', 'to', 'at'])
        && likeId == request.resource.data.to + '_' + request.auth.uid;
      allow delete: if request.auth != null && resource.data.from == request.auth.uid;
      allow update: if false;
    }

    // One rating per visitor per café, same key and ownership rules.
    match /petcafe_ratings/{ratingId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && request.resource.data.at is number
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && request.resource.data.keys().hasOnly(['from', 'to', 'stars', 'at'])
        && ratingId == request.resource.data.to + '_' + request.auth.uid;
      allow delete: if request.auth != null && resource.data.from == request.auth.uid;
    }

    // A one-way follow. Friends are pairs of follows, so following is not
    // enough on its own to see a private save; both players opt in.
    match /petcafe_follows/{followId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && request.resource.data.at is number
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 20
        && request.resource.data.keys().hasOnly(['from', 'to', 'at', 'name'])
        && followId == request.resource.data.from + '_' + request.resource.data.to;
      allow delete: if request.auth != null && resource.data.from == request.auth.uid;
      allow update: if false;
    }

    // A heartbeat while a player is in their café. Only its owner writes it.
    match /petcafe_presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'online', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 20
        && request.resource.data.online is bool
        && request.resource.data.at is number;
    }

    // One competition entry per player per week, snapshotted at entry time.
    // The id is "week_uid", so both have to agree with the stored data.
    match /petcafe_entries/{entryId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 20
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 99
        && request.resource.data.week is string
        && entryId == request.resource.data.week + '_' + request.auth.uid
        && request.resource.data.layout is map
        && request.resource.data.layout.items is list
        && request.resource.data.layout.items.size() <= 140
        && request.resource.data.animals is list
        && request.resource.data.animals.size() <= 6
        && request.resource.data.at is number
        && request.resource.data.keys().hasOnly(['uid', 'name', 'level', 'week', 'layout', 'animals', 'at']);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // One vote per account per week, written once and never for yourself.
    match /petcafe_votes/{voteId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && request.resource.data.week is string
        && request.resource.data.at is number
        && request.resource.data.keys().hasOnly(['from', 'to', 'week', 'at'])
        && voteId == request.resource.data.week + '_' + request.auth.uid;
      allow update, delete: if false;
    }


    /* ------------------------------------------------------------------
       BAKE OFF!
       Saves stay private; public profiles are readable by signed-in
       bakers. Matches are shared documents: everyone in a match can read
       the room, but each player may only write their own entry, and only
       the host (or anyone once the phase deadline has passed) may move the
       match on. A host who has gone quiet can be replaced. Votes are one
       document per voter, written once, never for yourself. Rewards are
       claimed once per account per match.
       ------------------------------------------------------------------ */
    function bakeoffMatch(matchId) {
      return get(/databases/$(database)/documents/bakeoff_matches/$(matchId)).data;
    }

    // The full save, private to its owner.
    match /bakeoff_saves/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // The public card the leaderboard reads.
    match /bakeoff_profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'level', 'xp', 'wins', 'matches', 'bestScore', 'chef', 'updated'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 20
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 99
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && request.resource.data.xp <= 9999999
        && request.resource.data.wins is int
        && request.resource.data.wins >= 0
        && request.resource.data.wins <= 99999
        && request.resource.data.matches is int
        && request.resource.data.matches >= 0
        && request.resource.data.matches <= 99999
        && request.resource.data.bestScore is int
        && request.resource.data.bestScore >= 0
        && request.resource.data.bestScore <= 200
        && request.resource.data.chef is map
        && request.resource.data.updated is number;
    }

    // A live match. Everyone signed in can read a room (public matchmaking
    // needs to find open rooms); writes are confined to players in it.
    match /bakeoff_matches/{matchId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['code', 'public', 'hostUid', 'createdAt', 'phase', 'phaseEndsAt', 'seq', 'themeId', 'themeSeed', 'players', 'results'])
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 4
        && request.resource.data.code.size() <= 8
        && request.resource.data.public is bool
        && request.resource.data.createdAt is int
        && request.resource.data.phase == 'lobby'
        && request.resource.data.phaseEndsAt is int
        && request.resource.data.seq is int
        && request.resource.data.themeId is string
        && request.resource.data.themeSeed is string
        && request.resource.data.results is string
        && request.resource.data.players is map
        && request.resource.data.players.size() == 1
        && request.auth.uid in request.resource.data.players
        && request.resource.data.players[request.auth.uid].keys().hasOnly(['name', 'level', 'chef', 'joinedAt', 'at', 'ready', 'readyPhase', 'score', 'design', 'left'])
        && request.resource.data.players[request.auth.uid].name is string
        && request.resource.data.players[request.auth.uid].name.size() <= 20;

      // A baker stepping into a room that is still in its lobby.
      allow update: if request.auth != null
        && !(request.auth.uid in resource.data.players)
        && resource.data.phase == 'lobby'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players'])
        && request.resource.data.players.diff(resource.data.players).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.players.size() <= 8
        && request.resource.data.players[request.auth.uid].keys().hasOnly(['name', 'level', 'chef', 'joinedAt', 'at', 'ready', 'readyPhase', 'score', 'design', 'left'])
        && request.resource.data.players[request.auth.uid].name is string
        && request.resource.data.players[request.auth.uid].name.size() <= 20
        && request.resource.data.players[request.auth.uid].at is int;

      // A player updating their own entry, or the host moving the round on.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.players
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase', 'phaseEndsAt', 'seq', 'themeId', 'hostUid', 'startedAt', 'players', 'results'])
        && request.resource.data.players.diff(resource.data.players).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.players.size() <= 8
        && request.resource.data.players[request.auth.uid].keys().hasOnly(['name', 'level', 'chef', 'joinedAt', 'at', 'ready', 'readyPhase', 'score', 'design', 'left'])
        && request.resource.data.players[request.auth.uid].name is string
        && request.resource.data.players[request.auth.uid].name.size() <= 20
        && request.resource.data.players[request.auth.uid].design is string
        && request.resource.data.players[request.auth.uid].design.size() <= 2400
        && request.resource.data.players[request.auth.uid].score is int
        && request.resource.data.players[request.auth.uid].score >= 0
        && request.resource.data.players[request.auth.uid].score <= 200
        && request.resource.data.players[request.auth.uid].at is int
        && (request.resource.data.phase == resource.data.phase
            || request.auth.uid == resource.data.hostUid
            || request.time.toMillis() > resource.data.phaseEndsAt)
        && (request.resource.data.hostUid == resource.data.hostUid
            || (request.resource.data.hostUid == request.auth.uid
                && resource.data.hostUid in resource.data.players
                && request.time.toMillis() - resource.data.players[resource.data.hostUid].at > 14000));

      // One vote per voter, written once, for someone else in this match.
      match /votes/{voterUid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && voterUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['from', 'to', 'at'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.to is string
          && request.resource.data.to != request.auth.uid
          && request.resource.data.to in bakeoffMatch(matchId).players
          && request.resource.data.at is int;
        allow update, delete: if false;
      }
    }

    // One reward claim per account per match, owned by that account.
    match /bakeoff_claims/{claimId} {
      allow read: if request.auth != null
        && claimId == resource.data.matchId + '_' + request.auth.uid;
      allow create: if request.auth != null
        && claimId == request.resource.data.matchId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.matchId is string
        && request.resource.data.matchId.size() <= 64
        && request.resource.data.at is int
        && request.resource.data.keys().hasOnly(['uid', 'matchId', 'at']);
      allow update, delete: if false;
    }

    // Friends are mutual follows, as in the café.
    match /bakeoff_follows/{followId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 20
        && request.resource.data.at is number
        && request.resource.data.keys().hasOnly(['from', 'to', 'name', 'at'])
        && followId == request.resource.data.from + '_' + request.resource.data.to;
      allow delete: if request.auth != null && resource.data.from == request.auth.uid;
      allow update: if false;
    }

    // A single pending invitation per recipient, written by the host.
    match /bakeoff_invites/{toUid} {
      allow read, delete: if request.auth != null
        && (request.auth.uid == toUid || request.auth.uid == resource.data.from);
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to == toUid
        && request.resource.data.fromName is string
        && request.resource.data.fromName.size() <= 20
        && request.resource.data.matchId is string
        && request.resource.data.code is string
        && request.resource.data.theme is string
        && request.resource.data.at is number
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'matchId', 'code', 'theme', 'at']);
      allow update: if false;
    }

    match /bakeoff_presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'state', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 20
        && request.resource.data.state is string
        && request.resource.data.at is int;
    }

    // Everything else stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
