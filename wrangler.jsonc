{
  // The Worker that serves dampgames.dk. `npx wrangler deploy` uses this file,
  // which is what stops Wrangler from refusing the repo over the old
  // Pages-style layout.
  "name": "damp",
  "compatibility_date": "2026-11-11",
  "main": "worker.js",
  "assets": {
    // The site itself lives in this folder; everything not listed in
    // .assetsignore is uploaded as a public file.
    "directory": ".",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },

  // Online games meet in a Room instead of a WebRTC peer connection, so they
  // keep working on networks that block direct player-to-player traffic.
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ]
}
